{
  "schema_version": 1,
  "id": "dynamic.item-pickup",
  "category": "dynamic-content",
  "description": "临时物品可以原子创建、拾取并在后续回合保持归属。",
  "initial_state": {
    "module": "paper-chase",
    "aliases": {"@item": "runtime-brass-key"}
  },
  "turns": [
    {
      "client_action_id": "baseline-pickup-item",
      "utterance": "拾起桌边临时发现的黄铜钥匙",
      "host_output": {
        "target": {"kind": "entity", "id": "@item"},
        "method": {"family": "pick_up", "description": "拾取黄铜钥匙"},
        "persistence_intent": "inventory",
        "success_effects": [
          {
            "type": "ensure_runtime_entity",
            "entity_id": "@item",
            "entity_kind": "object",
            "name": "黄铜钥匙",
            "location_id": "@scene"
          },
          {
            "type": "move_entity",
            "entity_id": "@item",
            "holder_actor_id": "@player"
          }
        ]
      }
    },
    {
      "client_action_id": "baseline-use-item",
      "utterance": "查看刚才拾起的黄铜钥匙",
      "host_output": {
        "target": {"kind": "entity", "id": "@item"},
        "method": {"family": "observe", "description": "查看黄铜钥匙"},
        "persistence_intent": "none",
        "success_effects": [{"type": "narrative_only"}]
      }
    }
  ],
  "expectation": {
    "terminal_statuses": ["completed"],
    "required_state": {
      "item.runtime-brass-key.custody": "actor_inventory",
      "item.runtime-brass-key.holder": "baseline-actor"
    },
    "known_gaps": ["dynamic_item_atomic_pickup_not_supported"],
    "known_gap_assertions": [
      "terminal_status",
      "required_state:item.runtime-brass-key.custody",
      "required_state:item.runtime-brass-key.holder"
    ]
  }
}

{
  "schema_version": 1,
  "id": "persistent.npc-death",
  "category": "persistent-state",
  "description": "NPC 死亡必须成为权威状态，后续回合不能恢复存活。",
  "initial_state": {
    "module": "paper-chase",
    "aliases": {"@npc": "melodias"},
    "state": {"scene_id": "cemetery"}
  },
  "turns": [
    {
      "client_action_id": "baseline-kill-npc",
      "utterance": "在冲突中杀死梅洛迪亚斯",
      "host_output": {
        "target": {"kind": "entity", "id": "@npc"},
        "method": {"family": "kill", "description": "致命攻击"},
        "persistence_intent": "character_state",
        "check": {
          "mode": "required",
          "candidates": [
            {
              "candidate_id": "fighting-brawl",
              "skill_id": "fighting-brawl",
              "difficulty": "regular",
              "method_summary": "在冲突中制服并杀死梅洛迪亚斯",
              "player_safe_reason": "致命结果必须先由受控检定证明"
            }
          ]
        },
        "success_effects": [
          {
            "type": "change_entity_state",
            "entity_id": "@npc",
            "key": "consciousness",
            "value": "dead"
          }
        ]
      }
    },
    {
      "client_action_id": "baseline-observe-dead-npc",
      "utterance": "确认梅洛迪亚斯的状态",
      "host_output": {
        "target": {"kind": "entity", "id": "@npc"},
        "method": {"family": "observe", "description": "观察 NPC 状态"},
        "persistence_intent": "none",
        "success_effects": [{"type": "narrative_only"}]
      }
    }
  ],
  "expectation": {
    "terminal_statuses": ["completed"],
    "required_state": {"entity.melodias.consciousness": "dead"}
  }
}

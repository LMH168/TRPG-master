  "source_fragments": [
    {"id": "briefing", "schema_version": 1, "visibility": "public", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=1"], "page": 1, "content": "托马斯·金博尔希望调查员找到偷窃书籍的贼人，尽可能追回这些书籍，并调查他的叔叔道格拉斯·金博尔是否尚在人世。"},
    {"id": "keeper_background", "schema_version": 1, "visibility": "keeper", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=1"], "page": 1, "content": "这段奇妙的友谊以此为开端，持续了五年之久。直到有一天，道格拉斯跟随他的朋友走进了属于食尸鬼的昏暗世界。"},
    {"id": "neighbors", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=2"], "page": 2, "requires_clues": ["douglas_cemetery"], "content": "其中一名邻居，莱拉·奥戴尔，回忆起金博尔先生曾经从他家窗前路过，去往公墓的方向，胳膊下还夹着一本书。"},
    {"id": "gravekeeper", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=2"], "page": 2, "requires_clues": ["favorite_grave"], "content": "公墓看守梅洛迪亚斯·杰弗逊会向调查员透露道格拉斯·金博尔在读书时常坐的那块墓碑。"},
    {"id": "library_history", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=2"], "page": 2, "requires_clues": ["old_report"], "content": "一篇十多年前的报道声称，有人目击一群看似未着寸缕的人在公共墓地里跳舞狂欢。形状怪异的脚印无言地证明他们确实存在。"},
    {"id": "newspaper_archive", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=3"], "page": 3, "requires_clues": ["hilda_statement"], "content": "希尔达·沃德女士声称她时常看见恶魔的子嗣出没于墓地附近，外观轮廓和人类相似，有犬类特征，足部呈蹄状，浑身沾满腐烂的泥土。"},
    {"id": "kimball_study", "schema_version": 1, "visibility": "public", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=3"], "page": 3, "content": "他的叔叔的藏书塞满了整个书房，这些书籍大小不一、形制各异，并且内容涵盖各个方面。"},
    {"id": "kimball_diary", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=3"], "page": 3, "requires_clues": ["diary_choice"], "content": "最后一条日记提及他已经作出决定，要加入我在地下的朋友们。日记中的记录暗示在公墓地下存在一个隧道网络。"},
    {"id": "cemetery_watch", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=3"], "page": 3, "requires_clues": ["night_silhouette"], "content": "检定成功的那个夜晚，一条人影离开公墓，径直前往金博尔宅，并且通过书房的窗户进入屋内。若窗户锁上了，人影会顶坏木条并撞碎玻璃。"},
    {"id": "ghoul_aftermath", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=4"], "page": 4, "requires_clues": ["douglas_truth"], "content": "若调查员因此陷入临时疯狂，他将大声尖叫并最终陷入昏迷。醒来时，调查员会发现自己正在阿诺兹堡疗养院。"},
    {"id": "douglas_dialogue", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=4-5"], "page": 4, "requires_clues": ["douglas_truth"], "content": "道格拉斯告诉调查员，他对人生的唯一诉求是可以随时随地阅读书籍，不被他人干扰。食尸鬼们将关闭这处出入口，所以这是他能取回更多自己书籍的最后一晚。"},
    {"id": "crypt_entry", "schema_version": 1, "visibility": "conditional", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=5"], "page": 5, "requires_clues": ["tunnel_hint"], "content": "调查员可以通过跟踪半足半蹄的脚印找到正确的坟墓入口。移开入口石板需要通过一次普通难度的力量检定。"},
    {"id": "douglas_stats", "schema_version": 1, "visibility": "keeper", "policy_origin": "module", "source_refs": ["source:追书人.pdf#page=5"], "page": 5, "content": "道格拉斯·金博尔：STR 85，CON 75，SIZ 65，INT 80，POW 65，DEX 40，EDU 85，HP 14，移动 9。"}
  ],

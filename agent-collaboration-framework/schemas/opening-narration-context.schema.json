{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opening-narration-context.schema.json",
  "$defs": {
    "NarrativeDetailView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "description",
            "sensory",
            "atmosphere",
            "pacing",
            "foreshadowing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "NarrativeDetailView",
      "type": "object"
    },
    "OpeningParticipant": {
      "additionalProperties": false,
      "description": "Public identity and status allowed in the shared opening narration.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "status_summary": {
          "default": "",
          "title": "Status Summary",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "name"
      ],
      "title": "OpeningParticipant",
      "type": "object"
    },
    "OpeningSceneContext": {
      "additionalProperties": false,
      "description": "Only the player-visible portion of the initial shared scene.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "OpeningSceneContext",
      "type": "object"
    },
    "WorldClockView": {
      "additionalProperties": false,
      "description": "Just the clock, sampled at one point in a turn (#245 §二.2).\n\nA PlayerView only ever carries *now*. A turn that advanced time therefore\nleaves no record of when its earlier steps happened, and the Narrator — who\nis handed the post-turn view — writes the whole turn at the final hour:\nwalk to the inn at noon, sleep until eight, narrated as arriving after dark.\nThis is the one field that repairs that, so it deliberately carries the clock\nalone and none of the other world flags.",
      "properties": {
        "day_index": {
          "default": 0,
          "minimum": 0,
          "title": "Day Index",
          "type": "integer"
        },
        "hour_of_day": {
          "default": 0,
          "maximum": 23,
          "minimum": 0,
          "title": "Hour Of Day",
          "type": "integer"
        },
        "time_of_day": {
          "default": "day",
          "enum": [
            "day",
            "night"
          ],
          "title": "Time Of Day",
          "type": "string"
        }
      },
      "title": "WorldClockView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Player-safe context for one authoritative public game opening.",
  "properties": {
    "background": {
      "description": "玩家可知的时代、地点、故事前提与叙事基调。",
      "minLength": 1,
      "title": "Background",
      "type": "string"
    },
    "scene": {
      "$ref": "#/$defs/OpeningSceneContext"
    },
    "world_time": {
      "$ref": "#/$defs/WorldClockView"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/OpeningParticipant"
      },
      "minItems": 1,
      "title": "Participants",
      "type": "array"
    },
    "solo_background_summary": {
      "default": "",
      "title": "Solo Background Summary",
      "type": "string"
    }
  },
  "required": [
    "background",
    "scene",
    "world_time",
    "participants"
  ],
  "title": "OpeningNarrationContext",
  "type": "object"
}
